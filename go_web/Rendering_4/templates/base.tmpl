<!DOCTYPE html>
<html lang="zh-CN">
<head><title>模板继承</title>
    <style>
        *{
            margin: 0;
        }
        .nav{
            height:50px;
            width: 100%;
            position: fixed;
            top: 0;
            background-color: burlywood;
        }
        .main{
            margin-top: 50px;
        }
        .menu{
            width:20%;
            height: 100%;
            position: fixed;
            left: 0;
            background-color: cornflowerblue;
        }
        .center {
            text-align: center;
        }
    </style>
</head>
<body>

<div class="nav"></div>
<div class="main">
    <div class="menu"></div>
    <div class="content center">
    {{/* 此处用block代替每个子模版不同的部分 */}}
  {{block "content" .}}{{end}}
    </div>
</div>

</body>
</html>